# Optional. Set in the shell or use --env-file .env explicitly.
FINLENS_DATA_DIR=data
FINLENS_PROVIDER=extractive
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty for an entirely offline, extractive demo.
# Local chat generation is not supported. Gemini config is in config/gemini.env.example.
FINLENS_CHAT_MODEL=
FINLENS_EMBED_MODEL=
# For Gemini, use config/gemini.env.example and run-gemini.cmd.
